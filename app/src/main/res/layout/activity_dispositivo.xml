<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Dispositivo simulado"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvConexionDispositivo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Sin conexión"
        android:textSize="16sp" />

    <Button
        android:id="@+id/btnConectarDispositivo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="Conectar dispositivo" />

    <TextView
        android:id="@+id/tvDatosDispositivo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Preparando simulación..."
        android:textSize="22sp" />

    <TextView
        android:id="@+id/tvUltimoComando"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Última orden: ninguna"
        android:textSize="16sp" />

    <Button
        android:id="@+id/btnVolverDispositivo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:minHeight="48dp"
        android:text="Volver al menú" />

</LinearLayout>